# CodeGenius Environment Template
# Duplicate this file as .env and fill in your values

# 🧠 Core Intelligence
GEMINI_API_KEY=your_gemini_api_key_here

# 🗄️ Database
# When running via Docker Compose, use: mongodb://database:27017/codegenius
MONGO_URI=mongodb://localhost:27017/codegenius

# 🌐 Server
PORT=8080
